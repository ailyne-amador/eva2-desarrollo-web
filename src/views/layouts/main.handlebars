<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650;9..144,750&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
      :root {
        --paper: #faf6ef;
        --ink: #1b1712;
        --accent: #e8490f;
        --muted: #6e675c;
        --line: #ddd5c7;
      }
      body { background: var(--paper); color: var(--ink); font-family: "Space Grotesk", sans-serif; }
      h1, h2, h3, .serif { font-family: "Fraunces", serif; font-weight: 650; }
      a { color: var(--accent); }
      .micro { text-transform: uppercase; letter-spacing: .14em; font-size: .72rem; color: var(--muted); font-weight: 500; }
      .rule { border-top: 1px solid var(--line); }
      .navbar-editorial { border-bottom: 1px solid var(--line); }
      .brand { font-family: "Fraunces", serif; font-weight: 750; font-size: 1.3rem; color: var(--ink); text-decoration: none; }
      .brand:hover { color: var(--ink); }
      .nav-link-ed { color: var(--ink); text-decoration: none; font-size: .9rem; }
      .nav-link-ed:hover { color: var(--accent); }
      .btn-ink { background: var(--ink); color: var(--paper); border: 1px solid var(--ink); border-radius: 0; padding: .55rem 1.4rem; font-weight: 500; display: inline-block; }
      .btn-ink:hover { background: var(--accent); border-color: var(--accent); color: #fff; }
      .btn-line { background: transparent; color: var(--ink); border: 1px solid var(--ink); border-radius: 0; padding: .55rem 1.4rem; display: inline-block; }
      .btn-line:hover { border-color: var(--accent); color: var(--accent); }
      .btn-sm-ed { padding: .3rem .9rem; font-size: .85rem; }
      .tabla { width: 100%; border-collapse: collapse; }
      .tabla th { text-transform: uppercase; letter-spacing: .12em; font-size: .7rem; color: var(--muted); font-weight: 500; border-bottom: 1px solid var(--ink); padding: .6rem .5rem; text-align: left; }
      .tabla td { border-bottom: 1px solid var(--line); padding: .85rem .5rem; vertical-align: middle; }
      .badge-estado { border: 1px solid var(--ink); background: transparent; color: var(--ink); font-size: .68rem; text-transform: uppercase; letter-spacing: .1em; padding: .3em .7em; font-weight: 500; }
      .badge-estado.activo { border-color: var(--accent); color: var(--accent); }
      .badge-estado.completado { border-color: var(--muted); color: var(--muted); }
      .form-control, .form-select { border-radius: 0; border: 1px solid var(--line); background: #fff; padding: .6rem .8rem; color: var(--ink); }
      .form-control:focus, .form-select:focus { border-color: var(--accent); box-shadow: none; }
      .alerta { border: 1px solid var(--accent); color: var(--accent); background: transparent; padding: .8rem 1rem; font-size: .9rem; }
      .num { font-family: "Fraunces", serif; color: var(--accent); font-size: 1.1rem; }
      .link-danger-ed { background: none; border: none; color: var(--accent); padding: 0; font-size: .9rem; }
      .link-danger-ed:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <header class="navbar-editorial">
      <div class="container d-flex align-items-center justify-content-between py-3">
        <a class="brand" href="/">MarketProyectos<span style="color: var(--accent)">.</span></a>
        <nav class="d-flex align-items-center gap-4">
          <a class="nav-link-ed" href="/proyectos">Proyectos</a>
          {{#if usuario}}
            <span class="micro mb-0">{{usuario.nombre}} {{usuario.apellido}}</span>
            <form method="post" action="/logout" class="m-0">
              <button class="btn-line btn-sm-ed" type="submit">Salir</button>
            </form>
          {{else}}
            <a class="nav-link-ed" href="/login">Ingresar</a>
            <a class="btn-ink btn-sm-ed text-decoration-none" href="/registro">Crear cuenta</a>
          {{/if}}
        </nav>
      </div>
    </header>
    <main class="container py-5">
      {{{body}}}
    </main>
    <footer class="container py-4 rule micro">Gestor de proyectos de marketing</footer>
  </body>
</html>
