<div class="row justify-content-center">
  <div class="col-md-5">
    <p class="micro mb-1">Bienvenido</p>
    <h1 class="h2 mb-4">Ingresar</h1>
    {{#if error}}<div class="alerta mb-4">{{error}}</div>{{/if}}
    <form method="post" action="/login">
      <div class="mb-3">
        <label class="micro d-block mb-2" for="correo">Correo</label>
        <input class="form-control" id="correo" type="email" name="correo" value="{{correo}}" required>
      </div>
      <div class="mb-4">
        <label class="micro d-block mb-2" for="password">Contraseña</label>
        <input class="form-control" id="password" type="password" name="password" required>
      </div>
      <button class="btn-ink w-100" type="submit">Ingresar</button>
    </form>
    <p class="mt-3" style="font-size: .9rem; color: var(--muted)">¿No tienes cuenta? <a href="/registro">Crea una</a></p>
  </div>
</div>
